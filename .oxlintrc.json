{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": { "correctness": "error", "suspicious": "error", "pedantic": "warn" },
  // Files here carry long comments by design, so the length budget counts what
  // a file *does* rather than what it explains — the rule fires on a file that
  // has grown too much to hold, not on one that says why.
  "rules": {
    "max-lines": ["warn", { "max": 300, "skipComments": true, "skipBlankLines": true }]
  }
}
