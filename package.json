{
  "name": "diagrams",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@mathjax/mathjax-newcm-font": "^4",
    "@mathjax/src": "^4"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "jsdom": "^30",
    "lefthook": "^1",
    "oxlint": "^1",
    "prettier": "^3",
    "typescript": "^5",
    "vite": "^7",
    "vitest": "^3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lefthook"
    ]
  }
}
