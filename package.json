  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/node": "^24",
    "jsdom": "^30",
    "lefthook": "^1",
    "oxlint": "^1",
    "prettier": "^3",
    "typescript": "^5",
    "vite": "^7",
    "vitest": "^3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lefthook"
    ]
  }
